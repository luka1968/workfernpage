{
  "name": "workfern-seo-builder",
  "version": "1.0.0",
  "description": "Multilingual programmatic SEO static site generator for Workfern",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:watch": "nodemon build.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('./output',{recursive:true,force:true});fs.mkdirSync('./output');\""
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "keywords": ["seo", "static-site", "multilingual", "programmatic-seo"],
  "author": "Workfern",
  "license": "MIT"
}
